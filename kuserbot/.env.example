# ─────────────────────────────────────────────────────────────
# PHANTOM-X Master Bot — Environment Configuration
# Copy this file to `.env` and fill in your values.
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────

# Telegram Bot token (from @BotFather)
BOT_TOKEN=123456789:AAAA-your-bot-token-here

# Telegram API credentials (from https://my.telegram.org)
API_ID=1234567
API_HASH=0123456789abcdef0123456789abcdef

# Admin IDs (comma-separated). The first/owner ID = SPECIAL_ADMIN_ID.
ADMIN_IDS=7839547993

# AES key for encrypting stored session strings.
# Generate once with:  python -c "from encryption import generate_key; print(generate_key().decode())"
# WARNING: keep this secret & backed-up — losing it = losing all stored sessions.
ENCRYPTION_KEY=

# ─────────────────────────────────────────────────────────────
# Worker Userbot (only needed when running userbot manually,
# the master bot injects these automatically on /deploy)
# ─────────────────────────────────────────────────────────────
# SESSION_STRING=
